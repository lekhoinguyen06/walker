{
  "name": "walker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "docs": "cd ./docs && mint dev",
    "gen-doc": "turbo run gen-doc",
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter=playground-react...",
    "dev:landing": "turbo run dev --filter=landing...",
    "build:react": "turbo run build --filter=playground-react...",
    "build:landing": "turbo run build --filter=landing...",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write \"**/*.{ts,tsx,md}\""
    ]
  },
  "packageManager": "pnpm@8.15.6",
  "dependencies": {
    "lint-staged": "^17.3.0"
  }
}
