{
  "name": "walker",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "docs": "cd ./docs && mint dev",
    "bake": "cd ./banhmi && bun run index.ts",
    "gen-doc": "turbo run gen-doc",
    "gen-api": "turbo run gen-api",
    "dev": "turbo run dev",
    "dev:react": "turbo run dev --filter=playground-react...",
    "dev:terminal": "turbo run dev --filter=\"./packages/walker-terminal\"...",
    "dev:server": "turbo run dev --filter=playground-server...",
    "dev:landing": "turbo run dev --filter=landing...",
    "build:react": "turbo run build --filter=playground-react...",
    "build:server": "turbo run build --filter=playground-server...",
    "build:landing": "turbo run build --filter=landing...",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "@types/bun": "latest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write \"**/*.{ts,tsx,md}\""
    ]
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "banhmi": "^0.1.1",
    "lint-staged": "^17.5.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
