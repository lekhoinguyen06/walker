{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "docs",
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#000000",
    "light": "#fff085",
    "dark": "#000000"
  },
  "favicon": "logo/walker-icon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "guides/vision", "guides/setup"]
          },
          {
            "group": "Concepts",
            "pages": ["guides/fundamentals"]
          }
        ]
      },
      {
        "tab": "Server",
        "groups": [
          {
            "group": "Typescript",
            "pages": ["server/ts/getting-started"]
          }
        ]
      },
      {
        "tab": "Client",
        "groups": [
          {
            "group": "React",
            "pages": [
              "client/react/setup",
              "client/react/item",
              "client/react/ade",
              "client/react/flow",
              "client/react/hooks"
            ]
          }
        ]
      },
      {
        "tab": "Roadmap",
        "pages": ["roadmap"]
      },
      {
        "tab": "Contributing",
        "groups": [
          {
            "group": "Policies",
            "pages": ["contributing/policies/ai"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Walker Server",
            "openapi": {
              "source": "./walker-server.openapi.json"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Walker",
      "href": "https://walker.vstaffs.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/lekhoinguyen06/walker",
      "website": "https://walker.vstaffs.com"
    }
  }
}
