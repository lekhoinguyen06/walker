{
  "name": "walker-core",
  "version": "0.1.3",
  "description": "Walker core library.",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "module": "index.ts",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "test": "vitest",
    "gen-doc": "bun exec typedoc --json typedoc.json src/index.ts && bash ./scripts/ship-doc.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/debug": "^4.1.13",
    "@types/jsdom": "^30.0.0",
    "bunup": "^0.16.32",
    "jsdom": "^30.0.1",
    "typedoc": "^0.28.20",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/object-hash": "^3.0.6",
    "chalk": "^6.0.0",
    "walker-shared": "workspace:*",
    "zod": "^4.6.5"
  }
}
