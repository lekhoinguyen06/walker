{
  "name": "walker-client",
  "version": "0.1.0",
  "description": "Walker Client library. It includes generated SDK and HTTP client.",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "module": "index.ts",
  "type": "module",
