{
  "name": "walker-client",
  "version": "0.2.0",
  "description": "Walker Client library. It includes generated SDK and HTTP client.",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "module": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen-api": "openapi-ts && bunup",
    "build": "bunup",
    "gen-doc": "bun exec typedoc --json typedoc.json src/client/index.ts src/client/client/index.ts && bash ./scripts/ship-doc.sh"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.0.0-next-20260930190945",
    "@types/bun": "latest",
    "bunup": "^0.16.32",
    "typedoc": "^0.28.20",
    "walker-server": "workspace:^"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
