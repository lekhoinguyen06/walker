{
  "name": "walker-server",
  "version": "0.2.0",
  "description": "Walker Server library.",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "module": "index.ts",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bunup --watch",
    "build": "bunup",
    "test": "vitest",
    "gen-api": "bun run ./scripts/generate.ts",
    "gen-doc": "bun exec typedoc --json typedoc.json src/index.ts && bash ./scripts/ship-doc.sh"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/bun": "latest",
    "@types/supertest": "^7.2.1",
    "ai": "^7.0.127",
    "bunup": "^0.16.32",
    "hono": "^4.13.13",
    "itty-fetcher": "^1.0.10",
    "supertest": "^7.3.1",
    "typedoc": "^0.28.20",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7",
    "zod": "^4.6.7",
    "ai": "^7.0.127"
  },
  "dependencies": {
    "walker-skill": "workspace:^",
    "walker-shared": "workspace:^",
    "itty-router": "^5.0.24",
    "zod-openapi": "^6.0.2"
  }
}
