{
  "name": "walker-react",
  "version": "0.1.0",
  "description": "Walker library adapter for React framework",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js",
      "require": "./dist/dev/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./dev/index.css": "./dist/dev/index.css"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "dev": "tsup --watch",
    "gen-doc": "pnpm exec typedoc --json typedoc.json src/index.ts"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.34",
    "@base-ui/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "walker-core": "workspace:*",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^13.0.0",
    "shadcn": "^4.18.0",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2"
  }
}
