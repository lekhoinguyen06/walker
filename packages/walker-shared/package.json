{
  "name": "walker-shared",
  "version": "0.2.0",
  "description": "Walker shared library.",
  "license": "MIT",
  "author": "Lê Khôi Nguyên",
  "module": "dist/index.js",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "gen-doc": "bun exec typedoc --json typedoc.json src/index.ts && bash ./scripts/ship-doc.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bunup": "^0.16.32",
    "typedoc": "^0.28.20"
  },
  "peerDependencies": {
    "typescript": "^7",
    "zod": "^4.6.7"
  }
}
