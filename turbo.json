{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "gen-doc": {
      "dependsOn": ["^gen-doc"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["typedoc.json"]
    },
    "gen-api": {
      "dependsOn": ["^gen-api"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["*.openapi.json", "src/client/**"]
    }
  },
  "ui": "tui"
}
