{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playground-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "PLAYGROUND_SERVER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
